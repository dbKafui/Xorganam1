PORT=3000

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://store.xorganam.example

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xorganam

REDIS_URL=redis://localhost:6379

# Legacy master key - only used to decrypt credential rows written before
# the Vault Transit migration. Never used for new encryption. Safe to
# keep set during the transition period; do not remove until all rows
# have been re-saved (which upgrades them to the Vault envelope format).
ENCRYPTION_MASTER_KEY=replace-with-a-long-random-secret-never-commit-this

# HashiCorp Vault Transit - L1 master key for envelope encryption of
# tenant Eganow / notification-provider credentials. The master key
# material lives only in Vault; the app only ever sees wrapped DEKs.
VAULT_ADDR=https://vault.internal.example.com:8200
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=master-key
VAULT_KV_MOUNT=secret
# Preferred: AppRole (short-lived tokens, per-service identity)
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Dev-only fallback if AppRole isn't configured - never a root token in prod
VAULT_TOKEN=

JWT_SECRET=replace-with-a-different-long-random-secret-never-commit-this
JWT_EXPIRY=8h
LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MS=900000
MAX_ACTIVE_SESSIONS=5
GLOBAL_SEARCH_RESULT_LIMIT=20
EMAIL_VERIFICATION_TOKEN_TTL_MS=1800000
EMAIL_VERIFICATION_REQUEST_LIMIT=3
EMAIL_VERIFICATION_RATE_WINDOW_MS=3600000
PASSWORD_RESET_TOKEN_TTL_MS=1800000
PASSWORD_RESET_REQUEST_LIMIT=3
PASSWORD_RESET_RATE_WINDOW_MS=3600000

# Resend is required for password-reset email delivery. Keep the sender address
# verified in Resend and use a domain appropriate for production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_URL=http://localhost:5173

EGANOW_BASE_URL=

SMS_GATEWAY_BASE_URL=https://api.smsgateway.example.com/
SMS_DEFAULT_SENDER_ID=XORGANAM
CHECKOUT_PUBLIC_URL=http://localhost:5173
CREDIT_PRE_DUE_REMINDER_DAYS=3
ORDER_PAYMENT_EXPIRY_MINUTES=15

WORKER_CONCURRENCY=10
COLLECTION_STATUS_POLL_DELAY_MS=5000
COLLECTION_STATUS_POLL_ATTEMPTS=12
COLLECTION_STATUS_QUEUE_ATTEMPTS=3
COLLECTION_STATUS_QUEUE_BACKOFF_MS=2000
COLLECT_FOR_ME_QUEUE_ATTEMPTS=5
COLLECT_FOR_ME_QUEUE_BACKOFF_MS=2000
SPLIT_PAYOUT_MAX_RETRIES=5

SEED_ADMIN_EMAIL=admin@xorganam.local
SEED_ADMIN_PASSWORD=ChangeMe!2026#
