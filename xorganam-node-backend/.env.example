PORT=3000

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xorganam

REDIS_URL=redis://localhost:6379

# Master key for AES-256-GCM envelope encryption of tenant Eganow
# credentials (combined with each tenant's own api_key_salt at
# encrypt/decrypt time). Use a real secrets manager in production.
ENCRYPTION_MASTER_KEY=replace-with-a-long-random-secret-never-commit-this

JWT_SECRET=replace-with-a-different-long-random-secret-never-commit-this
JWT_EXPIRY=8h

EGANOW_BASE_URL=

SMS_GATEWAY_BASE_URL=https://api.smsgateway.example.com/
SMS_DEFAULT_SENDER_ID=XORGANAM

WORKER_CONCURRENCY=10

SEED_ADMIN_EMAIL=admin@xorganam.local
SEED_ADMIN_PASSWORD=ChangeMe!2026#
