PORT=3000

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xorganam

REDIS_URL=redis://localhost:6379

# Legacy master key - only used to decrypt credential rows written before
# the Vault Transit migration. Never used for new encryption. Safe to
# keep set during the transition period; do not remove until all rows
# have been re-saved (which upgrades them to the Vault envelope format).
ENCRYPTION_MASTER_KEY=replace-with-a-long-random-secret-never-commit-this

# HashiCorp Vault Transit - L1 master key for envelope encryption of
# tenant Eganow / notification-provider credentials. The master key
# material lives only in Vault; the app only ever sees wrapped DEKs.
VAULT_ADDR=https://vault.internal.example.com:8200
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=master-key
# Preferred: AppRole (short-lived tokens, per-service identity)
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Dev-only fallback if AppRole isn't configured - never a root token in prod
VAULT_TOKEN=

JWT_SECRET=replace-with-a-different-long-random-secret-never-commit-this
JWT_EXPIRY=8h

EGANOW_BASE_URL=

SMS_GATEWAY_BASE_URL=https://api.smsgateway.example.com/
SMS_DEFAULT_SENDER_ID=XORGANAM

WORKER_CONCURRENCY=10

SEED_ADMIN_EMAIL=admin@xorganam.local
SEED_ADMIN_PASSWORD=ChangeMe!2026#
