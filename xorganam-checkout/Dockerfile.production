FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
COPY --from=shared . /shared/

# Vite validates these as distinct HTTPS origins during the production build.
ARG VITE_STOREFRONT_PUBLIC_URL
ARG VITE_OPERATOR_PUBLIC_URL
ARG VITE_API_BASE_URL
ARG VITE_BUILD_MODE=production
ENV VITE_STOREFRONT_PUBLIC_URL=$VITE_STOREFRONT_PUBLIC_URL
ENV VITE_OPERATOR_PUBLIC_URL=$VITE_OPERATOR_PUBLIC_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build -- --mode ${VITE_BUILD_MODE} && \
    node -e "const fs=require('fs'); const origin=new URL(process.env.VITE_API_BASE_URL).origin; fs.writeFileSync('/app/nginx.conf.generated', fs.readFileSync('/app/nginx.conf','utf8').replace('__API_ORIGIN__', origin))"

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/nginx.conf.generated /etc/nginx/conf.d/default.conf
EXPOSE 5174
