FROM node:20-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# Vite validates these as distinct HTTPS origins during the production build.
ARG VITE_STOREFRONT_PUBLIC_URL
ARG VITE_OPERATOR_PUBLIC_URL
ARG VITE_API_BASE_URL
ENV VITE_STOREFRONT_PUBLIC_URL=$VITE_STOREFRONT_PUBLIC_URL
ENV VITE_OPERATOR_PUBLIC_URL=$VITE_OPERATOR_PUBLIC_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 5174
